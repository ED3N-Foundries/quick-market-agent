# Secrets. The schema reads these and does not hardcode them.
TREASURY_PRIVATE_KEY=
NEAR_TREASURY_PRIVATE_KEY=
AGENT_SECRET=
RPC_URL=
USDC_ADDRESS=
TOKEN_ACCOUNT=

# Active network. The swarm stays on Base Sepolia. NEAR keys do not move it.
CHAIN=base-sepolia

# Whole numbers that sum to 100. A NEAR share other than 0 stops the runner.
AGENT_SPLIT_BASE=100
AGENT_SPLIT_NEAR=0

# Runner settings. Bun loads this single .env file.
DB_PATH=data/quick-market-agent.sqlite
API_URL=http://127.0.0.1:3001
SWARM_PIN=

# Market preferences. Must match the server's values.
WINDOW_SECONDS=10
MARKET_SECONDS=10
VIEW_SECONDS=5
FEE_BPS=0
PRICE_SOURCE=binance
GRANT_MICROS=100000000
GRANT_INTERVAL_MS=120000
